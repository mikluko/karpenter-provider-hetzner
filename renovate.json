{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["bot"],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["gomodTidy"],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Kubernetes libraries and Karpenter core move together",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "controller-gen, which the Taskfile runs at a version",
      "managerFilePatterns": ["/^Taskfile\\.yaml$/"],
      "matchStrings": ["go run (?<depName>sigs\\.k8s\\.io/controller-tools)/cmd/controller-gen@(?<currentValue>v\\S+)"],
      "datasourceTemplate": "go"
    }
  ]
}
